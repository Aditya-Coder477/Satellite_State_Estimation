{
    "network": {
        "input_dim": 8,
        "output_dim": 9,
        "hidden_layers": [
            256,
            256,
            256,
            256,
            256,
            256
        ],
        "activation": "silu",
        "residual_connections": true,
        "layer_norm": true,
        "dropout": 0.0
    },
    "optimizer": {
        "name": "adamw",
        "lr": 0.001,
        "weight_decay": "1e-5"
    },
    "scheduler": {
        "name": "cosine"
    },
    "training": {
        "batch_size": 512,
        "epochs": 500,
        "early_stopping": {
            "enabled": true,
            "patience": 20,
            "min_delta": "1e-6",
            "restore_best_weights": true
        },
        "gradient_clip": 1.0
    },
    "loss_balancing": {
        "mode": "auto",
        "normalize_losses": true,
        "manual_weights": {
            "transition": 1.0,
            "physics": 5.0,
            "residual": 2.0,
            "constraint": "1e-9"
        }
    },
    "losses": {
        "transition_weight": 1.0,
        "physics_weight": 5.0,
        "residual_weight": 2.0,
        "constraint_weight": 1.0
    },
    "rollout_training": {
        "enabled": true,
        "curriculum": true,
        "schedule": [
            {
                "epochs": [
                    1,
                    20
                ],
                "rollout_steps": 1
            },
            {
                "epochs": [
                    21,
                    40
                ],
                "rollout_steps": 2
            },
            {
                "epochs": [
                    41,
                    60
                ],
                "rollout_steps": 5
            },
            {
                "epochs": [
                    61,
                    100
                ],
                "rollout_steps": 10
            },
            {
                "epochs": [
                    101,
                    9999
                ],
                "rollout_steps": 20
            }
        ]
    }
}