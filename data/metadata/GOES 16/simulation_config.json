{
  "satellite": "GOES16",

  "ground_station_network": "GOES16_Observation_Network",

  "simulation_days": 7,

  "propagation_step_seconds": 60,

  "sampling_interval_seconds": 60,

  "gravity_model": "SGP4",

  "coordinate_frames": {

    "input": "TEME",

    "intermediate": "GCRS",

    "output": "ITRS"

  },

  "visibility": {

    "minimum_elevation_deg": 10.0

  },

  "noise": {

    "enabled": true,

    "model": "Gaussian",

    "ra_std_deg": 0.005,

    "dec_std_deg": 0.005,

    "seed": 42

  },

  "dataset": {

    "train_ratio": 0.70,

    "validation_ratio": 0.15,

    "test_ratio": 0.15

  }

}