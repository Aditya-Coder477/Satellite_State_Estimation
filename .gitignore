# ==============================================================================
# SATELLITE ORBIT LAB & PI-STN — .gitignore
# Prevents large data files, virtual environments, dependencies, and caches
# from bloating the repository, ensuring fast pushes and clones (< 40 MB).
# ==============================================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / optimized Python files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & Coverage caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node / Frontend dependencies
dashboard/frontend/node_modules/
node_modules/
.pnp
.pnp.js
.npm/
.eslintcache

# Large generated dataset CSV files (350+ MB)
# Note: JSON normalization configs & metadata are PRESERVED!
data/processed/**/*.csv
data/processed/*.csv

# System & OS files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
*.swp
*~
* (1).*


# IDE & Editor directories
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Experiment tracking
wandb/
runs/
.neptune/
